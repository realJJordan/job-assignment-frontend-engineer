{
  "name": "@kalamba/job-assignment-frontend-engineer",
  "version": "1.0.0",
  "author": "",
  "license": "ISC",
  "description": "Frontend skeleton for frontend engineer job assignment",
  "main": "index.js",
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "build": "craco build",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "lint": "eslint --ext .ts,.tsx src",
    "prepare": "husky",
    "dev": "npm run start",
    "start": "craco start",
    "test": "craco test",
    "generate:api": "orval --config orval.config.ts",
    "generate:styles": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/global.css",
    "watch:styles": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/global.css --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-router-dom": "5.3.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "6.30.4",
    "react-router-dom": "6.30.4",
    "react-scripts": "5.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "4.9.5",
    "web-vitals": "6.1.1"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "orval": "^7.13.2",
    "postcss": "^8.5.26",
    "prettier": "3.9.6"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
